# 이 파일을 .env로 복사한 뒤 실제 키를 입력하세요. .env는 Git에 올라가지 않습니다.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# 32바이트 이상의 임의 문자열. 절대 Git에 올리지 않는다.
JWT_SECRET=
# 로컬 HTTP에서는 false, HTTPS 배포 환경에서는 반드시 true.
AUTH_COOKIE_SECURE=false

# 장소 검색용 키도 같은 방식으로 둘 수 있습니다.
DATA_GO_KR_SERVICE_KEY=
MOIS_DATA_GO_KR_SERVICE_KEY=
