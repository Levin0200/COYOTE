# 이 파일을 .env로 복사한 뒤 실제 키를 입력하세요. .env는 Git에 올라가지 않습니다.
# 로컬과 운영 실행 DB는 MariaDB만 사용합니다.
DB_URL=jdbc:mariadb://127.0.0.1:3306/coyote_db_backend_mj
DB_USERNAME=
DB_PASSWORD=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# 32바이트 이상의 임의 문자열. 절대 Git에 올리지 않는다.
JWT_SECRET=
# 로컬 HTTP에서는 false, HTTPS 배포 환경에서는 반드시 true.
AUTH_COOKIE_SECURE=false

# 장소 검색용 키도 같은 방식으로 둘 수 있습니다.
DATA_GO_KR_SERVICE_KEY=
MOIS_DATA_GO_KR_SERVICE_KEY=

# 이메일 인증번호 발송. 로컬에서는 기본값(log)이면 서버 콘솔에 인증번호가 출력된다.
# 실제 메일을 보내려면 MAIL_PROVIDER=smtp로 바꾸고 아래를 채운다(운영은 smtp 고정).
# Gmail: 계정에서 2단계 인증을 켠 뒤 "앱 비밀번호" 16자리를 발급해 MAIL_PASSWORD에 넣는다(일반 로그인 비밀번호가 아니다).
MAIL_PROVIDER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# 비우면 MAIL_USERNAME을 쓴다. Gmail은 로그인한 계정 주소와 다르면 계정 주소로 바뀐다.
MAIL_FROM=
# 보내는 이름. 비우면 기본값(모여ON)을 쓴다. .env는 한글을 그대로 쓰면 깨지므로 바꾸려면 유니코드 이스케이프로 쓴다.
# MAIL_FROM_NAME=
