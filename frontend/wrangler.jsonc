{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coyote-meeting",
  "main": "./worker.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://54-66-7-72.sslip.io"
  }
}
